{
	"compilerOptions": {
		"lib": ["DOM", "ES2025"],
		"jsx": "react-jsx",
		"target": "ES2025",
		"noEmit": true,
		"skipLibCheck": true,
		"useDefineForClassFields": true,

		"paths": {
			"@/*": ["./src/*"]
		},

		"moduleDetection": "force",
		"moduleResolution": "bundler",
		"verbatimModuleSyntax": true,
		"resolveJsonModule": true,
		"allowImportingTsExtensions": true,

		"noUnusedLocals": true,
		"noUnusedParameters": true
	},
	"include": ["src"]
}
